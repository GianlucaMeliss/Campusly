<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # AGGIORNATO: Specifica la sottocartella in cui si trova il progetto
    RewriteBase /Campusly/

    # 🛡️ BLOCCO DI SICUREZZA: Vieta l'accesso alle cartelle di core e dati
    RewriteRule ^(app|config|data|views)(/.*)?$ - [F,L]

    # Se la richiesta è già per la cartella public, fermati qui
    RewriteRule ^public/ - [L]
    
    # Altrimenti, reindirizza tutto silenziosamente dentro public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Abilita PHP 8.4 su Altervista (assicurati che sia supportato dal tuo pannello)
AddHandler av-php84 .php